# PostgreSQL（VOC_PG_HUMAN_PASSWORD 是密钥）
VOC_PG_HOST=
VOC_PG_PORT=
VOC_PG_DB=
VOC_PG_HUMAN_USER=
VOC_PG_HUMAN_PASSWORD=

# 飞书企业自建应用（VOC_FEISHU_APP_SECRET 是密钥）
VOC_FEISHU_APP_ID=
VOC_FEISHU_APP_SECRET=

# 无状态会话签名（密钥，必须长期稳定保存）
VOC_SESSION_SECRET=

# 逗号分隔的公网根地址；每项的 /auth/feishu/callback 都要在飞书后台登记
VOC_PUBLIC_BASE_URLS=

# 逗号分隔的 open_id；变量必须存在，值为空时分别表示无人可读 / 无人可写
VOC_ALLOWED_OPEN_IDS=
VOC_WRITER_OPEN_IDS=

# 可选，默认 true；仅本地 HTTP 开发时设为 false
VOC_COOKIE_SECURE=

# 可选，只在取不到 Web 会话身份时作为 updated_by 降级值
VOC_APP_USER=
